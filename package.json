{
  "name": "getyes-desktop",
  "version": "0.1.17",
  "private": true,
  "description": "GetYes — application de bureau (Electron : SaaS embarqué + runtime local à venir)",
  "main": "main.js",
  "author": "GetYes",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder"
  },
  "build": {
    "appId": "com.getyes.app",
    "productName": "GetYes",
    "artifactName": "${productName}-Setup-${version}.${ext}",
    "publish": [
      {
        "provider": "github",
        "owner": "englermartinpro-ctrl",
        "repo": "getyes-desktop",
        "releaseType": "release"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/app-icon-v3.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "shortcutName": "GetYes",
      "include": "build/installer.nsh"
    },
    "protocols": [
      {
        "name": "GetYes Protocol",
        "schemes": [
          "getyes"
        ]
      }
    ]
  },
  "devDependencies": {
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "ws": "^8.21.1"
  }
}
